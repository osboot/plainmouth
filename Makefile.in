# SPDX-License-Identifier: GPL-2.0-or-later

PACKAGE_NAME    := @PACKAGE_NAME@
PACKAGE_VERSION := @PACKAGE_VERSION@

VERBOSE ?= $(V)
Q = $(if $(VERBOSE),,@)

PROGS =
PLUGINS =
GARBAGE =

bindir     = @bindir@
libdir     = @libdir@
libexecdir = @libexecdir@
pluginsdir = @libexecdir@/@PACKAGE_NAME@

PLUGINSDIR := $(CURDIR)/plugins
PTY_LIBS := @PTY_LIBS@
VTERM_CFLAGS := @VTERM_CFLAGS@
VTERM_LIBS := @VTERM_LIBS@

PTHREAD_CFLAGS := @PTHREAD_CFLAGS@
PTHREAD_LIBS   := @PTHREAD_LIBS@
NCURSES_CFLAGS := @NCURSES_CFLAGS@
NCURSES_LIBS   := @NCURSES_LIBS@
PANEL_CFLAGS   := @PANEL_CFLAGS@
PANEL_LIBS     := @PANEL_LIBS@

WARNINGS = \
	-Wall -W -Waggregate-return -Wconversion -Wdisabled-optimization \
	-Wmissing-declarations -Wmissing-format-attribute -Wmissing-noreturn \
	-Wmissing-prototypes -Wpointer-arith -Wredundant-decls -Wshadow \
	-Wstrict-prototypes -Wwrite-strings -Wmismatched-dealloc \
	#

CPPFLAGS = \
	-std=gnu99 -D_GNU_SOURCE -I$(CURDIR) -I$(CURDIR)/src \
	-DPLUGINSDIR=\"$(pluginsdir)\" \
	#

CFLAGS = -g -O0 -fPIC $(if $(DEBUG),-DDEBUG)
CFLAGS += $(PTHREAD_CFLAGS) $(NCURSES_CFLAGS) $(PANEL_CFLAGS)

override CFLAGS := $(WARNINGS) $(CFLAGS)
LDLIBS =

COMMON_SO   = libplainmouth.so
COMMON_SRC  = src/ipc.c src/request.c src/plugin.c src/dump.c \
	      src/plugin_helpers.c \
	      src/warray.c \
	      src/widget.c \
	      src/widget_keybindings.c \
	      src/widget_border.c \
	      src/widget_button.c \
	      src/widget_checkbox.c \
	      src/widget_hbox.c \
	      src/widget_hscroll.c \
	      src/widget_input.c \
	      src/widget_label.c \
	      src/widget_list_vbox.c \
	      src/widget_meter.c \
	      src/widget_pad_box.c \
	      src/widget_positioned.c \
	      src/widget_scroll_vbox.c \
	      src/widget_select.c \
	      src/widget_select_opt.c \
	      src/widget_spinbox.c \
	      src/widget_spacer.c \
	      src/widget_textview.c \
	      src/widget_tailview.c \
	      src/widget_tooltip.c \
	      src/widget_vbox.c \
	      src/widget_vscroll.c \
	      src/widget_window.c \
	      #
COMMON_OBJ  = $(COMMON_SRC:.c=.o)
COMMON_LIBS = $(NCURSES_LIBS) $(PANEL_LIBS)
GARBAGE += $(COMMON_SO) $(COMMON_OBJ)

PROGS += plainmouthd
SRC_plainmouthd = src/plainmouthd.c src/daemon_style.c src/daemon_instance.c src/daemon_task.c src/daemon_worker.c src/daemon_event.c src/daemon_help.c src/daemon_animation.c
OBJ_plainmouthd = $(SRC_plainmouthd:.c=.o)
LIB_plainmouthd = $(PTHREAD_LIBS) $(NCURSES_LIBS) $(PANEL_LIBS) -L$(CURDIR) -lplainmouth
GARBAGE += plainmouthd $(OBJ_plainmouthd)

PROGS += plainmouth
SRC_plainmouth = src/plainmouth.c
OBJ_plainmouth = $(SRC_plainmouth:.c=.o)
LIB_plainmouth = -L$(CURDIR) -lplainmouth
GARBAGE += plainmouth $(OBJ_plainmouth)

PROGS += plaindialog
OBJ_plaindialog = src/plaindialog.o
GARBAGE += plaindialog $(OBJ_plaindialog)

PLUGINS = $(basename $(notdir $(wildcard src/plugins/*-main.c)))
PLUGINS := $(PLUGINS:-main=)
GARBAGE += $(PLUGINSDIR)

quiet_cmd = $(if $(VERBOSE),$(3),$(Q)printf "  %-08s%s\n" "$(1)" "$(2)"; $(3))

cmd_MKDIR = $(call quiet_cmd,MKDIR,$(patsubst $(CURDIR)/%,%,$(1))/,mkdir -p) -- $(1)
cmd_COPY = $(call quiet_cmd,COPY,$(patsubst $(CURDIR)/%,%,$(1)),cp -a) -- $(1) $(2)
cmd_LINK  = $(call quiet_cmd,LD,$(patsubst $(CURDIR)/%,%,$@),$(LINK.o)) $(1) $(LOADLIBES) $(LDLIBS) -o $@

.PHONY: all clean

TARGETS = \
	$(PROGS) \
	$(patsubst %,$(PLUGINSDIR)/%.so,$(PLUGINS)) \
	#

all: $(TARGETS)

clean:
	$(Q)$(RM) -r -- $(GARBAGE)

plugins: Makefile
	$(call cmd_MKDIR,$(PLUGINSDIR))

%.o: %.c
	$(call quiet_cmd,CC,$<,$(COMPILE.c)) $(CFLAGS) $(OUTPUT_OPTION) $<

$(COMMON_SO): Makefile $(COMMON_OBJ)
	$(call quiet_cmd,LD,$@,$(CC) -shared -o $@ $(COMMON_OBJ)) $(COMMON_LIBS)

plainmouthd: Makefile $(COMMON_SO) $(OBJ_plainmouthd) plugins
	$(call cmd_LINK,$(OBJ_plainmouthd)) $(LIB_plainmouthd)

plainmouth:  Makefile $(COMMON_SO) $(OBJ_plainmouth)
	$(call cmd_LINK,$(OBJ_plainmouth)) $(LIB_plainmouth)

plaindialog: Makefile $(COMMON_SO) $(OBJ_plaindialog)
	$(call cmd_LINK,$(OBJ_plaindialog)) $(LIB_plainmouth)

### Plugins

PLUGINS_LIBS  = -shared -ldl $(NCURSES_LIBS) $(PANEL_LIBS) -L$(CURDIR) -lplainmouth
PLUGINS_SRC   = $(wildcard src/plugins/*.c)
PLUGINS_OBJ   = $(PLUGINS_SRC:.c=.o)
PLUGINS_NAMES = $(patsubst src/plugins/%-main.c,%,$(filter %-main.c,$(PLUGINS_SRC)))
GARBAGE += $(PLUGINS_OBJ)

$(PLUGINS_OBJ) src/plainmouthd.o src/plugin.o: src/plugin.h
src/plugin_helpers.o $(PLUGINS_OBJ): src/plugin_helpers.h src/plugin.h src/request.h
$(COMMON_OBJ) $(PLUGINS_OBJ) src/plainmouthd.o: src/widget.h
src/plainmouthd.o src/daemon_style.o: src/daemon_style.h
src/daemon_style.o: src/widget.h src/request.h
src/plainmouthd.o src/daemon_instance.o: src/daemon_instance.h
src/daemon_instance.o: src/daemon_style.h src/widget.h src/plugin.h src/request.h
src/plainmouthd.o src/daemon_task.o: src/daemon_task.h src/request.h
src/plainmouthd.o src/daemon_worker.o: src/daemon_worker.h
src/daemon_worker.o: src/daemon_task.h src/ipc.h
src/plainmouthd.o src/daemon_event.o: src/daemon_event.h
src/daemon_event.o: src/daemon_instance.h src/plugin.h src/widget.h
src/daemon_help.o: src/daemon_help.h src/daemon_animation.h src/widget.h

plugin_objs = $(filter src/plugins/$(1)-%.o,$(PLUGINS_OBJ))

define build_plugin =
$(PLUGINSDIR)/$(1).so: $$(call plugin_objs,$(1))
	$$(call cmd_LINK,$$^) $(PLUGINS_LIBS) $(if $(filter termbox,$(1)),$(PTY_LIBS) $(VTERM_LIBS))
endef

$(foreach n,$(PLUGINS_NAMES),\
	$(eval $(call build_plugin,$(n))))

src/plugins/termbox-main.o src/plugins/termbox-output.o: src/plugins/termbox-output.h
src/plugins/termbox-output.o: CFLAGS += $(VTERM_CFLAGS)
src/plugins/termbox-main.o src/plugins/termbox-input.o: src/plugins/termbox-input.h

### Tests

.PHONY: check build-checks

VALGRIND = valgrind --error-exitcode=1 \
	--leak-check=full --time-stamp=yes --trace-children=yes \
	--track-fds=yes --track-origins=yes \
	#

TESTS := $(sort $(basename \
	$(wildcard tests/ipc/ipc_*.c) \
	$(wildcard tests/warray/warray_*.c) \
	$(wildcard tests/widget/widget_*.c) \
	$(wildcard tests/daemon/daemon_*.c) \
))
TESTS_E2E := $(sort $(basename \
	$(wildcard tests/e2e-*.sh) \
))

GARBAGE += $(TESTS) \
	$(wildcard tests/*.chk) \
	$(wildcard tests/*.chk.e2e) \
	$(wildcard tests/*.dump) \
	$(wildcard tests/*.log) \
	$(wildcard tests/*.sock)

.NOTINTERMEDIATE: $(TESTS)

build-checks: $(TESTS)

tests/daemon/%: tests/daemon/%.o src/daemon_task.o
	$(call cmd_LINK,$^) $(PTHREAD_LIBS)

tests/daemon/daemon_task_test.o: src/daemon_task.h src/request.h
GARBAGE += tests/daemon/daemon_task_test.o

tests/daemon/daemon_worker_test: tests/daemon/daemon_worker_test.o src/daemon_worker.o src/daemon_task.o src/ipc.o
	$(call cmd_LINK,$^) $(PTHREAD_LIBS)

tests/daemon/daemon_worker_test.o: src/daemon_worker.h src/daemon_task.h src/ipc.h
GARBAGE += tests/daemon/daemon_worker_test.o

tests/daemon/daemon_resize_test: tests/daemon/daemon_resize_test.o src/daemon_instance.o src/daemon_style.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(COMMON_LIBS) $(PTHREAD_LIBS) -Wl,-rpath,$(CURDIR)

tests/daemon/daemon_resize_test.chk: VALGRIND += --suppressions=$(CURDIR)/tests/valgrind.supp

tests/daemon/daemon_resize_test.o: src/daemon_instance.h src/plugin.h src/widget.h
GARBAGE += tests/daemon/daemon_resize_test.o

tests/daemon/daemon_help_test: tests/daemon/daemon_help_test.o src/daemon_help.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(COMMON_LIBS) -Wl,-rpath,$(CURDIR)

tests/daemon/daemon_help_test.chk: VALGRIND += --suppressions=$(CURDIR)/tests/valgrind.supp

tests/daemon/daemon_help_test.o: src/daemon_help.h src/daemon_animation.h src/widget.h
GARBAGE += tests/daemon/daemon_help_test.o

tests/daemon/daemon_animation_test: tests/daemon/daemon_animation_test.o src/daemon_animation.o
	$(call cmd_LINK,$^) $(NCURSES_LIBS)

tests/daemon/daemon_animation_test.chk: VALGRIND += --suppressions=$(CURDIR)/tests/valgrind.supp

tests/daemon/daemon_animation_test.o: src/daemon_animation.h
GARBAGE += tests/daemon/daemon_animation_test.o

tests/daemon/daemon_cursor_test: tests/daemon/daemon_cursor_test.o $(COMMON_SO) plainmouthd plugins
	$(call cmd_LINK,$(filter %.o,$^)) $(VTERM_LIBS) -L$(CURDIR) -lplainmouth -Wl,-rpath,$(CURDIR)

tests/daemon/daemon_cursor_test.chk: VALGRIND += --suppressions=$(CURDIR)/tests/valgrind.supp
tests/daemon/daemon_cursor_test.chk: CHECK_TIMEOUT = 15s

tests/daemon/daemon_cursor_test.o: src/ipc.h
tests/daemon/daemon_cursor_test.o: CFLAGS += $(VTERM_CFLAGS)
GARBAGE += tests/daemon/daemon_cursor_test.o

tests/ipc/%: tests/ipc/%.o src/ipc.o
	$(call cmd_LINK,$^)

tests/warray/%: tests/warray/%.o src/warray.o
	$(call cmd_LINK,$^)

tests/widget/%: tests/widget/%.o src/widget.o
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS)

tests/widget/widget_box_test: tests/widget/widget_box_test.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS) -Wl,-rpath,$(CURDIR)

tests/widget/widget_box_test.o: src/widget.h
GARBAGE += tests/widget/widget_box_test.o

tests/widget/widget_menu_test: tests/widget/widget_menu_test.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS) -Wl,-rpath,$(CURDIR)

tests/widget/widget_menu_test.o: src/widget.h
GARBAGE += tests/widget/widget_menu_test.o

tests/widget/widget_input_test: tests/widget/widget_input_test.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS) -Wl,-rpath,$(CURDIR)

tests/widget/widget_input_test.o: src/widget.h
GARBAGE += tests/widget/widget_input_test.o

tests/widget/widget_positioned_test: tests/widget/widget_positioned_test.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS) -Wl,-rpath,$(CURDIR)

tests/widget/widget_positioned_test.o: src/widget.h
GARBAGE += tests/widget/widget_positioned_test.o

tests/widget/widget_spinbox_test: tests/widget/widget_spinbox_test.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS) -Wl,-rpath,$(CURDIR)

tests/widget/widget_spinbox_test.o: src/widget.h
GARBAGE += tests/widget/widget_spinbox_test.o

tests/widget/widget_style_test: tests/widget/widget_style_test.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS) -Wl,-rpath,$(CURDIR)

tests/widget/widget_style_test.o: src/widget.h
GARBAGE += tests/widget/widget_style_test.o

tests/widget/widget_tailview_test: tests/widget/widget_tailview_test.o $(COMMON_SO)
	$(call cmd_LINK,$^) $(NCURSES_LIBS) $(PANEL_LIBS) -Wl,-rpath,$(CURDIR)

tests/widget/widget_tailview_test.o: src/widget.h
GARBAGE += tests/widget/widget_tailview_test.o

tests/widget/widget_termbox_output_test: tests/widget/widget_termbox_output_test.o src/plugins/termbox-output.o $(COMMON_SO)
	$(call cmd_LINK,$(filter %.o,$^)) $(COMMON_LIBS) $(VTERM_LIBS) -L$(CURDIR) -lplainmouth -Wl,-rpath,$(CURDIR)

tests/widget/widget_termbox_output_test.o: src/plugins/termbox-output.h src/widget.h
GARBAGE += tests/widget/widget_termbox_output_test.o

tests/widget/widget_termbox_input_test: tests/widget/widget_termbox_input_test.o src/plugins/termbox-input.o
	$(call cmd_LINK,$^)

tests/widget/widget_termbox_input_test.o: src/plugins/termbox-input.h
GARBAGE += tests/widget/widget_termbox_input_test.o

CHECK_TIMEOUT ?= 5s

tests/%.chk: tests/%
	@timeout -s KILL $(CHECK_TIMEOUT) $(VALGRIND) "$<" >"$<.log" 2>&1 && status='ok' || status='fail'; \
	flock -x $(CURDIR)/tests printf '%4s %s\n' "$$status" "$<"; \
	echo $$status > $@

tests/%.chk.e2e: tests/%.sh $(TARGETS)
	@timeout -s KILL 5s "$<" >"$<.log" 2>&1 && status='ok' || status='fail'; \
	flock -x $(CURDIR)/tests printf '%4s %s\n' "$$status" "$<"; \
	echo $$status > $@

check: $(addsuffix .chk,$(TESTS)) $(addsuffix .chk.e2e,$(TESTS_E2E))
	@ret=0; ! grep -qsx fail -- $^ || ret=1; $(RM) -- $^; exit $$ret;

.PHONY: install

install: $(TARGETS)
	$(call cmd_MKDIR,$(DESTDIR)$(bindir))
	$(call cmd_MKDIR,$(DESTDIR)$(libdir))
	$(call cmd_MKDIR,$(DESTDIR)$(pluginsdir))
	$(call cmd_COPY,$(PROGS),$(DESTDIR)$(bindir))
	$(call cmd_COPY,$(COMMON_SO),$(DESTDIR)$(libdir))
	$(call cmd_COPY,$(PLUGINSDIR)/*.so,$(DESTDIR)$(pluginsdir))
